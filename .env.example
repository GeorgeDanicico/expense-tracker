SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional, server-only. Bypasses every database rule; needed for kid accounts and username sign-in.
SUPABASE_SECRET_KEY=sb_secret_your_key
PRICE_SERVICE_URL=http://localhost:8080
APP_CURRENCY=EUR
SITE_URL=http://localhost:3000
FAMILY_ENABLED=false
# Web Push (browser notifications). Generate a pair with `npx web-push generate-vapid-keys`.
# The private key is secret and read only by the worker. See "Web Push (VAPID) keys" in README.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# AI budgets, in US dollars a month (docs/statement-import-plan.md). Both are optional.
# A family (or a user without one) may spend AI_FAMILY_MONTHLY_USD; when everyone together reaches
# AI_MONTHLY_BUDGET_USD the AI kill switch turns off.
# AI_FAMILY_MONTHLY_USD=3
# AI_MONTHLY_BUDGET_USD=10
# Comma-separated user ids of the admins, who are told when the global budget turns AI off.
# APP_ADMIN_USER_IDS=
# AI provider (docs/statement-import-plan.md). Leave AI_PROVIDER unset and AI is off for everyone.
# OPENAI_API_KEY is secret and server-only: never give it a NEXT_PUBLIC_ prefix.
# A feature's model must be in src/lib/ai/pricing.ts, or its calls are refused.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL_STATEMENTS=gpt-5.6-luna
# Development only: register the service worker under `npm run dev` to try push locally.
NEXT_PUBLIC_SW_IN_DEV=false
