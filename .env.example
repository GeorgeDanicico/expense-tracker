# Every server variable the app reads, read through src/lib/env.ts.
# REQUIRED: the process refuses to start without it, naming the variable (never its value).
# OPTIONAL: the app starts without it; the feature named next to it is off. Defaults are in src/lib/env.ts.
# The web container and the worker container share one env file (scripts/deploy.sh), so set them all there.

# --- Supabase ---------------------------------------------------------------------------------
# REQUIRED (web and worker): the project URL, an http(s) address.
SUPABASE_URL=https://your-project-ref.supabase.co
# REQUIRED (web): the publishable key, used for every signed-in request.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# REQUIRED (worker), OPTIONAL for the web app. Server-only: it bypasses every database rule.
# Without it the web app still starts, but kid accounts, username sign-in, profile pictures and the
# AI budgets fail; the worker exits at once.
SUPABASE_SECRET_KEY=sb_secret_your_key

# --- The app (web) ----------------------------------------------------------------------------
# OPTIONAL: the public address of the app. Sign-in links and MCP use the request's own address when unset.
SITE_URL=http://localhost:3000
# OPTIONAL: the investment price service. Investment price lookups fail without it.
PRICE_SERVICE_URL=http://localhost:8080
# OPTIONAL: the family module is on only when this is exactly "true". Default: off.
FAMILY_ENABLED=false

# --- Web Push (browser notifications) ---------------------------------------------------------
# OPTIONAL. Generate a pair with `npx web-push generate-vapid-keys`; see "Web Push (VAPID) keys" in README.md.
# VAPID_PUBLIC_KEY: read by the web app (browsers subscribe with it) and the worker.
# VAPID_PRIVATE_KEY and VAPID_SUBJECT (a mailto: or https: address): read only by the worker, to send.
# Without any of the three the worker logs push_not_configured and leaves notifications pending; it
# still runs its daily clean-up (old notifications, expired import drafts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- AI (web) ---------------------------------------------------------------------------------
# OPTIONAL. AI is off unless AI_PROVIDER, OPENAI_API_KEY and the feature's model are all set.
# OPENAI_API_KEY is secret and server-only: never give it a NEXT_PUBLIC_ prefix.
# A feature's model must be in src/lib/ai/pricing.ts, or its calls are refused: gpt-6-luna,
# gpt-6-sol, gpt-6.1-terra, gpt-5.6-luna, gpt-5.6-sol or gpt-5.6-terra.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL_STATEMENTS=gpt-5.6-luna
# Budgets in US dollars a month (docs/statement-import-plan.md). A family (or a user without one) may
# spend AI_FAMILY_MONTHLY_USD; when everyone together reaches AI_MONTHLY_BUDGET_USD the AI kill switch turns off.
# AI_FAMILY_MONTHLY_USD=3
# AI_MONTHLY_BUDGET_USD=10
# Comma-separated user ids of the admins, who are told when the global budget turns AI off.
# APP_ADMIN_USER_IDS=

# --- Worker -----------------------------------------------------------------------------------
# OPTIONAL: the build written with the worker's heartbeat. The Dockerfile sets it from the git commit.
# GIT_SHA=

# --- Browser, development only (not a server variable; not read by src/lib/env.ts) -----------
# Register the service worker under `npm run dev` to try push locally.
NEXT_PUBLIC_SW_IN_DEV=false
